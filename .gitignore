# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)

# vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon

# vercel
.vercel

# env files: ignore every real one...
.env*
# ...but the placeholder template must be committed. This negation has to
# come last, because the last matching pattern is the one git honours.
!.env.example
