# ---------------------------------------------------------------------------
# Copy to .env.local and fill in from your Neon project. .env.local is
# gitignored — never commit real values.
#
#   Neon Console -> your project -> Auth        -> Configuration -> Auth URL
#   Neon Console -> your project -> Data API    -> API           -> API URL
#   Neon Console -> your project -> Connect     -> connection string
# ---------------------------------------------------------------------------

# PUBLIC — these are shipped to the browser on purpose.
# They are endpoint addresses, not credentials. Row Level Security is what
# protects the data behind them: every request still needs a signed JWT, and
# every policy restricts rows to the user that token identifies.
NEXT_PUBLIC_NEON_AUTH_URL=https://REPLACE-ME.neonauth.REGION.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://REPLACE-ME.apirest.REGION.aws.neon.tech/neondb/rest/v1

# SERVER-ONLY — must never be prefixed with NEXT_PUBLIC_ and never committed.
# Used only to apply db/schema.sql; no runtime code path reads it.
DATABASE_URL=postgresql://USER:PASSWORD@REPLACE-ME.REGION.aws.neon.tech/neondb?sslmode=require
