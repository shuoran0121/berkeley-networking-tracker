# ---------------------------------------------------------------------------
# Copy to .env.local and fill in from your Neon project.
# .env.local is gitignored — never commit real values.
#
#   neon neon-auth status   -> Base URL   (NEXT_PUBLIC_NEON_AUTH_URL)
#   neon data-api get       -> Url        (NEXT_PUBLIC_NEON_DATA_API_URL)
#   neon link               -> writes DATABASE_URL for you
#
# Or from the Neon Console: Auth -> Configuration, and Data API -> API.
# ---------------------------------------------------------------------------

# PUBLIC — shipped to the browser on purpose.
# These are endpoint addresses, not credentials. Row Level Security is what
# protects the data behind them: every request still needs a JWT signed by Neon
# Auth, and every policy restricts rows to the user that token identifies.
NEXT_PUBLIC_NEON_AUTH_URL=https://REPLACE-ME.neonauth.REGION.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://REPLACE-ME.apirest.REGION.aws.neon.tech/neondb/rest/v1

# SERVER-ONLY — must never be prefixed with NEXT_PUBLIC_, and never committed.
# Used only by `npm run db:push` to apply db/schema.sql. No runtime code path
# reads it, and it is deliberately not set in Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@REPLACE-ME.REGION.aws.neon.tech/neondb?sslmode=require

# NOT USED by this implementation, and intentionally absent:
#   NEON_AUTH_BASE_URL       — auth runs in the browser against the URL above
#   NEON_AUTH_COOKIE_SECRET  — there is no server-side session cookie to sign,
#                              so there is no cookie secret that could leak
